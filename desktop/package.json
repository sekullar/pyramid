{
  "name": "pyramid",
  "version": "0.1.0",
  "description": "AI-assisted, all-black Markdown notebook",
  "main": "electron/main.js",
  "license": "MIT",
  "author": "Ahmet Efe Korkmaz",
  "repository": {
    "type": "git",
    "url": "https://github.com/sekullar/pyramid.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test electron/sync/sync.test.js electron/sync/server.test.js electron/sync/manager.test.js electron/sync/ot.test.js electron/sync/live.test.js electron/phoneix.test.js",
    "start": "vite build && electron .",
    "dist:local": "node scripts/build-local.js",
    "dist": "vite build && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "dompurify": "^3.2.4",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "marked": "^15.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.sekullar.pyramid",
    "productName": "Pyramid",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "!electron/**/*.test.js",
      "dist/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
