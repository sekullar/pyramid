<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Pure black, like the desktop app. System bars are drawn by the app (edge to edge). -->
    <style name="Theme.Pyramid" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorAccent">#FFFFFF</item>
        <item name="android:windowBackground">@color/pyr_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
    <color name="pyr_bg">#000000</color>
</resources>
